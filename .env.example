# Gateway environment (spec 3.9). Copy to .env and fill in real values.
#
# Invariant 7: .env is git-ignored and never committed. A hook blocks edits to
# it so a secret cannot be written into the repository by accident.

# development | staging | production
FREDPD_ENV=development

# Loopback only. The outside world reaches the gateway through Caddy.
FREDPD_GATEWAY_HOST=127.0.0.1
FREDPD_GATEWAY_PORT=3080

# Shared secret signing both directions of the FXServer link.
# Must match `set fredpd:gateway_secret` in server.cfg -- use `set`, never
# `setr`, which would replicate it to every client.
# Generate one with: openssl rand -hex 32
FREDPD_GATEWAY_SECRET=

# Discord bot (M1). Needs the Server Members privileged intent, and its own
# role must sit above every role it manages.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Database (M1).
DATABASE_URL=mysql://fredpd:password@127.0.0.1:3306/fredpd
