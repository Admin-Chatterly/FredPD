# Gateway environment (spec 3.9). Copy to .env and fill in real values.
#
# YOU DO NOT NEED THIS TO RUN FREDPD. The gateway is off by default
# (`gateway.enabled = false` in config/server.lua) and FXServer never calls it.
# Role sync -- the one thing it used to be needed for -- runs inside FXServer
# now (ADR-010). This file is for working on the gateway itself.
#
# Invariant 7: .env is git-ignored and never committed. A hook blocks edits to
# it so a secret cannot be written into the repository by accident.

# development | staging | production
FREDPD_ENV=development

# Loopback only. The outside world reaches the gateway through Caddy.
FREDPD_GATEWAY_HOST=127.0.0.1
FREDPD_GATEWAY_PORT=3080

# Shared secret signing both directions of the FXServer link.
# Must match `gateway.secret` in config/server.lua.
# Generate one with: openssl rand -hex 32
FREDPD_GATEWAY_SECRET=

# Discord bot, for role *actions* -- hire, promote, demote (spec 4.2). Not
# built. Reading roles does not happen here: that is FXServer's job now, and
# its token lives in config/server.lua.
# A bot that writes roles needs its own role above every role it manages.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Database. Only read when FREDPD_SCHEDULER_ENABLED=true (below); the media
# and PDF services need no database connection of their own.
DATABASE_URL=mysql://fredpd:password@127.0.0.1:3306/fredpd

# Media store (spec 3.2, 9, 12.2). A local directory by default; the origin
# below is what the NUI's build is told to trust (`web/vite.config.ts`'s
# VITE_MEDIA_HOST, baked into the CSP at build time) -- keep the two in step.
FREDPD_MEDIA_DIR=./data/media
FREDPD_MEDIA_BASE_URL=http://127.0.0.1:3080
FREDPD_MEDIA_TOKEN_TTL=300
FREDPD_MEDIA_MAX_BYTES=15728640

# The scheduler (spec 13.3): the lapsed-lookout sweep and retention. Off by
# default like the rest of the gateway; switching it on requires DATABASE_URL
# above to be a real, reachable database.
FREDPD_SCHEDULER_ENABLED=false
FREDPD_SCHEDULER_INTERVAL=300
FREDPD_RETENTION_QUERY_LOG_DAYS=365
FREDPD_RETENTION_ALPR_READS_DAYS=90
FREDPD_RETENTION_STALE_DRAFTS_DAYS=180
FREDPD_RETENTION_SURVEILLANCE_SESSIONS_DAYS=730
